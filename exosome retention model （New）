# 7.  BOOTSTRAP UNCERTAINTY  (non-parametric, n=500)

# =============================================================================

def bootstrap_fit(n_boot=500, seed=0):
“”“Bootstrap resampling of (time-point) residuals to estimate parameter CI.”””
rng = np.random.default_rng(seed)
p_base = dict(PARAMS_NOMINAL)
results = {k: [] for k in PK_FIT_PARAMS}

```
for b in range(n_boot):
    idx = rng.integers(0, len(DATA_TIME), size=len(DATA_TIME))
    t_b  = DATA_TIME[idx]
    bm_b = BLOOD_MEAN[idx] + rng.normal(0, BLOOD_SD[idx])
    bs_b = BLOOD_SD[idx]
    lm_b = LIVER_MEAN[idx] + rng.normal(0, LIVER_SD[idx])
    ls_b = LIVER_SD[idx]

    x0 = np.log([p_base[k] for k in PK_FIT_PARAMS]) + rng.normal(0, 0.1, 6)
    res = minimize(
        cost_m3, x0,
        args=(t_b, bm_b, bs_b, lm_b, ls_b, p_base),
        method="Nelder-Mead",
        options={"maxiter": 10000, "xatol": 1e-6, "fatol": 1e-6},
    )
    if res.success:
        for i, name in enumerate(PK_FIT_PARAMS):
            results[name].append(np.exp(res.x[i]))

return results
```

