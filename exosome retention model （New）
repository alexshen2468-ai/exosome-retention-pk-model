“K_m”:     10.0,    # %ID      Michaelis constant
“k_deg”:   0.01,    # h⁻¹  intracellular degradation
“q”:       0.05,    # h⁻¹  drug release rate
“k_cleard”:0.02,    # h⁻¹  drug clearance
“EC50”:    5.0,     # a.u. half-maximal effect concentration
}

T_SPAN = (0, 168)
T_EVAL = np.linspace(0, 168, 1000)

