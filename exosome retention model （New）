PARAMS_NOMINAL = {
# PK
“k_clear”: 0.35,    # h⁻¹  systemic elimination
“k_to”:    0.15,    # h⁻¹  blood → organ
“k_bp”:    0.08,    # h⁻¹  blood → peripheral
