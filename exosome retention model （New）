# 4.  CLASSICAL (M1 / M2) ALTERNATIVES

# =============================================================================

def one_cmpt_odes(t, y, p):
“”“M1 – one blood compartment, no reservoir.”””
B = y[0]
dB = -(p[“k_clear”] + p[“k_to”]) * B
dLf =  p[“k_to”] * B - p[“V_max”] * y[1] / (p[“K_m”] + y[1])
return [dB, dLf]

def two_cmpt_odes(t, y, p):
“”“M2 – two-compartment, no reservoir.”””
B, P, Lf = y
dB  = -(p[“k_clear”] + p[“k_to”] + p[“k_bp”]) * B + p[“k_pb”] * P
dP  =  p[“k_bp”] * B - p[“k_pb”] * P
dLf =  p[“k_to”] * B - p[“V_max”] * Lf / (p[“K_m”] + Lf)
return [dB, dP, dLf]

def solve_m1(params):
y0 = [100.0, 0.0]
sol = solve_ivp(one_cmpt_odes, T_SPAN, y0, args=(params,),
t_eval=T_EVAL, rtol=1e-6, atol=1e-9)
return sol

def solve_m2(params):
y0 = [100.0, 0.0, 0.0]
sol = solve_ivp(two_cmpt_odes, T_SPAN, y0, args=(params,),
t_eval=T_EVAL, rtol=1e-6, atol=1e-9)
return sol

