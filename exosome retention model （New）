def compute_plateau_duration(sol, threshold_frac=0.95):
“””
Duration (h) over which hepatic level stays ≥ threshold_frac × peak.
Returns 0 if peak is tiny.
“””
liver = sol.y[2] + sol.y[3]
peak  = np.max(liver)
if peak < 1e-6:
return 0.0
above = sol.t[liver >= threshold_frac * peak]
if len(above) < 2:
return 0.0
return float(above[-1] - above[0])

