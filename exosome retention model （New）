# 5.  PARAMETER FITTING  (weighted SSR, Levenberg-Marquardt via scipy)

# =============================================================================

PK_FIT_PARAMS  = [“k_clear”, “k_to”, “k_bp”, “k_pb”, “k_bind”, “k_rel”]
SCALE_FACTOR   = 3.7   # approximate ratio of observed to modelled hepatic peak

def cost_m3(theta_log, data_time, blood_m, blood_sd, liver_m, liver_sd, p_base):
“”“Weighted SSR over blood + liver for M3.”””
p = dict(p_base)
names = PK_FIT_PARAMS
for i, name in enumerate(names):
p[name] = np.exp(theta_log[i])

```
sol = solve_model(p, t_span=(0, 168), t_eval=data_time)
if not sol.success or np.any(sol.y < -1e-3):
    return 1e9

B_pred  = sol.y[0]
Lf_pred = (sol.y[2] + sol.y[3]) * SCALE_FACTOR   # scale for ⁹⁹Zr offset

res_b = (B_pred  - blood_m) / blood_sd
res_l = (Lf_pred - liver_m) / liver_sd
return float(np.sum(res_b**2) + np.sum(res_l**2))
```

def fit_m3(n_restarts=10, seed=42):
“”“Fit M3 with multiple random initialisations.”””
rng = np.random.default_rng(seed)
p_base = dict(PARAMS_NOMINAL)
best_cost, best_theta = np.inf, None

```
x0_default = np.log([p_base[k] for k in PK_FIT_PARAMS])

for _ in range(n_restarts):
    x0 = x0_default + rng.normal(0, 0.3, size=len(x0_default))
    res = minimize(
        cost_m3, x0,
        args=(DATA_TIME, BLOOD_MEAN, BLOOD_SD, LIVER_MEAN, LIVER_SD, p_base),
        method="Nelder-Mead",
        options={"maxiter": 20000, "xatol": 1e-8, "fatol": 1e-8},
    )
    if res.fun < best_cost:
        best_cost = res.fun
        best_theta = res.x

p_fit = dict(p_base)
for i, name in enumerate(PK_FIT_PARAMS):
    p_fit[name] = np.exp(best_theta[i])
return p_fit, best_cost
```

