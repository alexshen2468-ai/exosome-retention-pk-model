# 6.  AICC CALCULATION

# =============================================================================

def compute_aicc(ssr, n_obs, k_params):
“”“Bias-corrected AIC.”””
ll = -n_obs / 2 * np.log(ssr / n_obs) - n_obs / 2
aic  = -2 * ll + 2 * k_params
aicc = aic + 2 * k_params * (k_params + 1) / max(n_obs - k_params - 1, 1)
return aicc

