def sobol_analysis(n_samples=1024):
try:
from SALib.sample import saltelli
from SALib.analyze import sobol as sobol_analyze
except ImportError:
print(“SALib not installed – skipping Sobol analysis. pip install SALib”)
return None

```
problem = {
    "num_vars": 4,
    "names": ["k_rel", "k_bind", "V_max", "EC50"],
    "bounds": [
        [0.002, 0.006],
        [0.010, 0.030],
        [0.25,  0.75],
        [2.5,   7.5],
    ],
}
param_values = saltelli.sample(problem, n_samples, calc_second_order=False)

Y = np.zeros(param_values.shape[0])
p = dict(PARAMS_NOMINAL)
for i, row in enumerate(param_values):
    p["k_rel"], p["k_bind"], p["V_max"], p["EC50"] = row
    sol = solve_model(p)
    if sol.success:
        liver_total = sol.y[2] + sol.y[3]
        Y[i] = np.trapz(liver_total, sol.t)   # hepatic AUC
    else:
        Y[i] = np.nan

mask = ~np.isnan(Y)
Si = sobol_analyze.analyze(problem, Y[mask], calc_second_order=False, print_to_console=False)
return problem, Si
```

